{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TailoringReportV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "baseResumeSha256", "jdAnalysisSha256",
    "changedSections", "matchedKeywords", "unsupportedClaims", "warnings"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "baseResumeSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "jdAnalysisSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "changedSections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sectionId", "summary"],
        "properties": {
          "sectionId": { "type": "string" },
          "summary": { "type": "string" }
        }
      }
    },
    "matchedKeywords": { "type": "array", "items": { "type": "string" } },
    "unsupportedClaims": { "type": "array", "items": { "type": "string" } },
    "warnings": { "type": "array", "items": { "type": "string" } }
  }
}
